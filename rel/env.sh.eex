#!/bin/sh
# Node naming for clustering: RELEASE_NODE=conveyor@<routable ip>. Kubernetes sets POD_IP
# via the downward API; on EC2 the private IP comes from IMDS; otherwise the hostname.
if [ -z "$RELEASE_NODE" ]; then
  NODE_IP="${POD_IP:-${NODE_IP:-}}"
  if [ -z "$NODE_IP" ] && [ "${CLUSTER_STRATEGY:-none}" = "ec2" ]; then
    TOKEN=$(curl -s -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 60" http://169.254.169.254/latest/api/token 2>/dev/null)
    NODE_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4 2>/dev/null)
  fi
  export RELEASE_NODE="${CLUSTER_NODE_BASENAME:-conveyor}@${NODE_IP:-$(hostname -f 2>/dev/null || hostname)}"
fi
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
# Pin the distribution port range so security groups / network policies can allow it.
export ERL_AFLAGS="${ERL_AFLAGS:-} -kernel inet_dist_listen_min ${DIST_PORT_MIN:-9100} inet_dist_listen_max ${DIST_PORT_MAX:-9100}"
