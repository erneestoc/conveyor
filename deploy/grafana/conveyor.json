{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Conveyor",
  "uid": "conveyor",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(conveyor_ingest_workers_count, instance)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ack latency (client-visible durability)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(conveyor_ingest_ack_latency_us_bucket{instance=~\"$instance\"}[5m]))) / 1000",
          "legendFormat": "p50 ms"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(conveyor_ingest_ack_latency_us_bucket{instance=~\"$instance\"}[5m]))) / 1000",
          "legendFormat": "p99 ms"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Events committed / s",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(conveyor_ingest_batch_committed_events{instance=~\"$instance\"}[1m]))",
          "legendFormat": "events/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Open streams and workers",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(conveyor_ingest_streams_count{instance=~\"$instance\"})",
          "legendFormat": "streams"
        },
        {
          "refId": "B",
          "expr": "sum(conveyor_ingest_workers_count{instance=~\"$instance\"})",
          "legendFormat": "workers"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Writer group commit duration",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(conveyor_ingest_writer_flush_duration_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50 ms"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(conveyor_ingest_writer_flush_duration_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p99 ms"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Postgres: query time and pool queue (p99)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(conveyor_repo_query_total_time_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "query p99 ms"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(conveyor_repo_query_queue_time_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "pool queue p99 ms"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP request duration p99",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(phoenix_endpoint_stop_duration_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p99 ms"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "BEAM memory",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vm_memory_total{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "BEAM processes and run queue",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vm_system_counts_process_count{instance=~\"$instance\"}",
          "legendFormat": "processes {{instance}}"
        },
        {
          "refId": "B",
          "expr": "vm_total_run_queue_lengths_total{instance=~\"$instance\"}",
          "legendFormat": "run queue {{instance}}"
        }
      ]
    }
  ],
  "description": "Ingest health for the Conveyor BES server. Alert suggestions: ack p99 > 250 ms 5m, writer flush p99 > 500 ms, pool queue p99 > 50 ms (see docs/production.md)."
}
